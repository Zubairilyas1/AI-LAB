   "source": [
    "from collections import deque\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Transportation Network\n",
    "graph = {\n",
    "    \"FAST University\": [\n",
    "        \"NUST Metro Station\"\n",
    "    ],\n",
    "\n",
    "    \"NUST Metro Station\": [\n",
    "        \"Saddar Metro Station\",\n",
    "        \"Faiz Ahmed Faiz Metro Station\",\n",
    "        \"G-11 Metro Station\"\n",
    "    ],\n",
    "\n",
    "    \"Saddar Metro Station\": [\n",
    "        \"Faiz Ahmed Faiz Metro Station\"\n",
    "    ],\n",
    "      # add remaining nodes and their connections as given in the lab task document.\n",
    "}\n",
    "\n",
    "# 2. BFS Function\n",
    "\n",
    "def bfs(graph, start, goal):\n",
    "\n",
    "    # define frontier queue \n",
    "\n",
    "    #define visited set\n",
    "\n",
    "#track parent of each node\n",
    "    parent = {\n",
    "        start: None\n",
    "    }\n",
    "#track level\n",
    "    level = {\n",
    "        start: 0\n",
    "    }\n",
    "\n",
    "    expansion_order = []\n",
    "\n",
    "    #print(\"Initial Queue:\", list(queue))\n",
    "   \n",
    "    while queue:\n",
    "\n",
    "        \n",
    "        \n",
    "\n",
    "        # Goal test when node is removed from queue\n",
    "        \n",
    "\n",
    "        for neighbor in graph[current]:\n",
    "\n",
    "            pass\n",
    "\n",
    "    \n",
    "    # Reconstruct Solution Path\n",
    "    \n",
    "\n",
    "    pass\n",
    "\n",
    "\n",
    "\n",
    "# 3. Run BFS\n",
    "\n",
    "\n",
    "start = \"FAST University\"\n",
    "goal = \"PIMS Metro Station\"\n",
    "\n",
    "order, levels, path = bfs(\n",
    "    graph,\n",
    "    start,\n",
    "    goal\n",
    ")\n",
    "\n",
    "# 4. Display Results\n",
    "\n",
    "\n",
    "print(\" RESULTS OF BFS SEARCH \")\n",
    "\n",
    "print(\"Initial State:\", start)\n",
    "print(\"Goal State:\", goal)\n",
    "\n",
    "print(\"\\nLevels:\")\n",
    "\n",
    "for node in path:\n",
    "    print(f\"Level {levels[node]}: {node}\")\n",
    "\n",
    "print(\"\\nTraversal / Expansion Order:\")\n",
    "\n",
    "for node in order:\n",
    "    print(node)\n",
    "\n",
    "print(\"\\nSolution Path:\")\n",
    "\n",
    "print(\" → \".join(path))\n",
    "\n",
    "print(\"\\nNumber of Transitions:\", len(path) - 1)\n",
    "\n",
    "\n",
    "# 5. NetworkX Visualization\n",
    "\n",
    "\n",
    "G = nx.DiGraph()\n",
    "\n",
    "# add nodes and edges to the graph\n",
    "\n",
    "# set positions for nodes in the graph\n",
    "#pos = \n",
    "\n",
    "# Draw all nodes and edges\n",
    "\n",
    "\n",
    "# draw the edges of the graph with arrows\n",
    "\n",
    "# label the nodes with their names and set font size \n",
    "\n",
    "\n",
    "\n",
    "# Highlight solution path\n",
    "\n",
    "path_edges = list(zip(path, path[1:]))\n",
    "\n",
    "# draw the edges of the solution path with a different color and width\n",
    "\n",
    "plt.title(\"Task 1 - BFS Solution Path\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
