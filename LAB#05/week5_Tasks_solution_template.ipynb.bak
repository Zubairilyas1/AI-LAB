    "## Task 4: UCS for Delivery Route Optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c3c5d1af",
   "metadata": {},
   "outputs": [],
   "source": [
    "import heapq\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. WEIGHTED GRAPH\n",
    "\n",
    "\n",
    "graph = {\n",
    "    \"Islamabad Delivery Hub\": [\n",
    "        (\"I-8 Markaz\", 4),\n",
    "        (\"H-8 Markaz\", 2)\n",
    "    ],\n",
    "\n",
    "    \"I-8 Markaz\": [\n",
    "        (\"F-8 Markaz\", 5)\n",
    "    ],\n",
    "\n",
    "    # add other nodes and their connections with weights as given in the lab task document.\n",
    "}\n",
    "\n",
    "\n",
    "# 2. UCS FUNCTION\n",
    "\n",
    "\n",
    "def ucs(graph, start, goal):\n",
    "\n",
    "    # Priority Queue\n",
    "   \n",
    "\n",
    "    # Add starting node with cost 0\n",
    "    \n",
    "\n",
    "    # Best cost found so far for each node\n",
    "    best_cost = {\n",
    "        start: 0\n",
    "    }\n",
    "\n",
    "    # Parent dictionary for path reconstruction\n",
    "    \n",
    "    # To record expansion order\n",
    "    traversal_order = []\n",
    "\n",
    "    \n",
    "\n",
    "    \n",
    "    # 3. SEARCH\n",
    "    \n",
    "\n",
    "    while priority_queue:\n",
    "\n",
    "        pass\n",
    "\n",
    "\n",
    "\n",
    "# 5. RUN UCS\n",
    "\n",
    "\n",
    "start = \"Islamabad Delivery Hub\"\n",
    "# define goal state\n",
    "\n",
    "traversal_order, path, best_cost = ucs(\n",
    "    graph,\n",
    "    start,\n",
    "    goal\n",
    ")\n",
    "\n",
    "\n",
    "# 6. DISPLAY RESULTS\n",
    "\n",
    "\n",
    "print(\"Traversal Order:\")\n",
    "print(traversal_order)\n",
    "\n",
    "print(\"\\nSolution Path:\")\n",
    "print(\" → \".join(path))\n",
    "\n",
    "print(\"\\nTotal Path Cost:\")\n",
    "print(best_cost[goal])"
   ]
