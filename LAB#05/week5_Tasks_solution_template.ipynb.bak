   "id": "03c24ab2",
   "metadata": {},
   "outputs": [],
   "source": [
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "# TASK 3: DFS - WAREHOUSE ROBOT\n",
    "\n",
    "\n",
    "warehouse = {\n",
    "\n",
    "    \"Receiving Area\": [\n",
    "        \"Main Aisle\"\n",
    "    ],\n",
    "\n",
    "    \"Main Aisle\": [\n",
    "        \"Electronics\",\n",
    "        \"Grocery\",\n",
    "        \"Packaging\"\n",
    "    ],\n",
    "\n",
    "    \"Electronics\": [\n",
    "        \"Phones\",\n",
    "        \"Laptops\"\n",
    "    ],\n",
    "\n",
    "    \"Phones\": [\n",
    "        \"Inspection Area\"\n",
    "    ],\n",
    "\n",
    "    \"Laptops\": [],\n",
    "\n",
    "    \"Grocery\": [\n",
    "        \"Food\",\n",
    "        \"Drinks\"\n",
    "    ],\n",
    "\n",
    "    # add other areas and their connections Given in the lab task document.\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "# DFS\n",
    "\n",
    "\n",
    "def dfs(graph, start, goal):\n",
    "\n",
    "    # define frontier stack\n",
    "    \n",
    "    \n",
    "    #define visited set\n",
    "  \n",
    "    \n",
    "#track parent of each node\n",
    "    parent = {\n",
    "        start: None\n",
    "    }\n",
    "#track traversal order\n",
    "    traversal_order = []\n",
    "\n",
    "   \n",
    "\n",
    "   \n",
    "\n",
    "    while stack:\n",
    "\n",
    "        # Goal test when node is removed from stack\n",
    "        \n",
    "        \n",
    "        # Loop through neighbors of the current node and add them to the stack if they haven't been visited yet       \n",
    "        \n",
    "        \n",
    "        \n",
    "        \n",
    "        \n",
    "    # Reconstruct path\n",
    "    \n",
    "\n",
    "    #path = []\n",
    "\n",
    "    \n",
    "    \n",
    "        pass\n",
    "\n",
    "\n",
    "\n",
    "# Run DFS\n",
    "\n",
    "\n",
    "start = \"Receiving Area\"\n",
    "goal = \"Inspection Area\"\n",
    "\n",
    "order, path, visited = dfs(\n",
    "    warehouse,\n",
    "    start,\n",
    "    goal\n",
    ")\n",
    "\n",
    "# Results\n",
    "\n",
    "\n",
    "print(\" RESULTS\")\n",
    "\n",
    "print(\"Traversal Order:\")\n",
    "\n",
    "print(\" → \".join(order))\n",
    "\n",
    "print(\"\\nSolution Path:\")\n",
    "\n",
    "print(\" → \".join(path))\n",
    "\n",
    "print(\"\\nNumber of States Explored:\")\n",
    "\n",
    "print(len(visited))"
   ]
